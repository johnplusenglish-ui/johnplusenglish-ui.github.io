#!/bin/sh
# Pre-commit hook: validate the Cambridge exam pages before they can be committed.
# Each validator only runs when one of its own pages is actually staged, so commits to the
# rest of the site are unaffected.
# Install: cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Bypass once (not recommended): git commit --no-verify

staged=$(git diff --cached --name-only)
fail=0

case "$staged" in
  *c1-reading-test-content.html*|*uoe-c1-content.html*|*c1-writing-content.html*|*c1-speaking-content.html*)
    echo "Running C1 validation…"
    node tools/validate-c1.mjs || fail=1
    ;;
esac

case "$staged" in
  *b2-reading-test-content.html*|*uoe-b2-content.html*|*b2-writing-content.html*|*b2-speaking-content.html*)
    echo "Running B2 validation…"
    node tools/validate-b2.mjs || fail=1
    ;;
esac

case "$staged" in
  *b1-reading-test-content.html*|*b1-writing-content.html*|*b1-speaking-content.html*|*b1-grammar-content.html*)
    echo "Running B1 validation…"
    node tools/validate-b1.mjs || fail=1
    ;;
esac

case "$staged" in
  *c2-reading-test-content.html*|*uoe-c2-content.html*|*c2-writing-content.html*|*c2-speaking-content.html*)
    echo "Running C2 validation…"
    node tools/validate-c2.mjs || fail=1
    ;;
esac

if [ "$fail" = "1" ]; then
  echo ""
  echo "Commit blocked: fix the errors above, or use 'git commit --no-verify' to override."
  exit 1
fi
exit 0
